  "textual_rules": [
    {
      "id": "TG-01",
      "claim": "图提供关系坐标，不提供从自由症状自动得到脏腑诊断的完整算法",
      "evidence": ["D01", "D02", "D08"],
      "status": "I",
      "falsifier": "原图或相邻原文出现完整、无外部前提的症状到脏腑映射"
    },
    {
      "id": "TG-02",
      "claim": "用味对应补，体味对应泻，化味对应本脏所苦状态的纠偏；三者相连而不等同",
      "evidence": ["D01", "D02", "D05"],
      "status": "I",
      "falsifier": "任一脏区图文对读无法与其补、泻、急食条文逐项对应"
    },
    {
      "id": "TG-03",
      "claim": "化是两输入味指向第三味的功能关系，不强制方中另有输出味药物",
      "evidence": ["D05"],
      "status": "I+V",
      "falsifier": "原文明确规定化味只能由实际第三味药承担，且所有可靠方例均遵守"
    },
    {
      "id": "TG-04",
      "claim": "除是味对与方证共同约束的条件关系，味对共现不是充分条件",
      "evidence": ["D05"],
      "status": "I+V",
      "falsifier": "同一除味对在可靠方例中无条件、无反例地总与对应状态同现"
    },
    {
      "id": "TG-05",
      "claim": "五化和五除把全部十种异味无序组合完整、互斥地分为两类",
      "evidence": ["D05"],
      "status": "D+I",
      "falsifier": "原图存在重复味对、遗漏异味对或同一味对兼属化与除"
    },
    {
      "id": "TG-06",
      "claim": "多味方可以同时包含多条化与除关系，主次由方证、用量、制法和方内角色决定",
      "evidence": ["D04"],
      "status": "I+V",
      "falsifier": "原文明确规定每方只容许一个味对关系或只按味对数量定主次"
    },
    {
      "id": "TG-07",
      "claim": "经法味位、五行互含位和本草性味是不同字段，来源冲突时不得覆盖合并",
      "evidence": ["D03", "D09"],
      "status": "I",
      "falsifier": "原文明确宣称二十五味表就是所有本草来源的唯一药味校订表"
    },
    {
      "id": "TG-08",
      "claim": "七与六可解释原图进退及辅行诀大补大泻局部结构，不能作为一般经方的通用味数分类器",
      "evidence": ["D06"],
      "status": "D+I+V",
      "falsifier": "任意来源可靠的七味方均为补、六味方均为泻，且不存在反例"
    },
    {
      "id": "TG-09",
      "claim": "图式可以进入经方检验，但结构相容不能单独推出脏腑归类或作者原意",
      "evidence": ["D07"],
      "status": "I+V",
      "falsifier": "图后文本把二旦六神和张仲景体系明确排除在经法关系之外"
    },
    {
      "id": "TG-10",
      "claim": "神农本草经总纲对图式增加四气、毒性、制法、剂型和七情等约束，但不同来源的五味补泻表不得强行合并",
      "evidence": ["D08", "D09"],
      "status": "D+I",
      "falsifier": "两部原文明确声明其味位、语义层级和配属完全同一"
    }
  ],
