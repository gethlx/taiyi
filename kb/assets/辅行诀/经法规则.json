  "direct_evidence": [
    {
      "id": "D01",
      "source": "fuxingjue",
      "contains": "肝德在散。故经云：以辛补之，以酸泻之。肝苦急，急食甘以缓之"
    },
    {
      "id": "D02",
      "source": "fuxingjue",
      "contains": "脾德在缓。故《经》云：以甘补之，辛泻之；脾苦湿，急食苦以燥之"
    },
    {
      "id": "D03",
      "source": "fuxingjue",
      "contains": "五味之变，不可胜数。今者约列二十五种，以明五行互含之迹，以明五味变化之用"
    },
    {
      "id": "D04",
      "source": "fuxingjue",
      "contains": "主于补、泻者为君；数量同于君而非主，故为臣；从于佐监者，为佐、使"
    },
    {
      "id": "D05",
      "source": "fuxingjue",
      "contains": "此图乃《汤液经法》尽要之妙"
    },
    {
      "id": "D06",
      "source": "fuxingjue",
      "contains": "阳\n\n进\n\n为\n\n补\n\n其\n\n数\n\n七"
    },
    {
      "id": "D07",
      "source": "fuxingjue",
      "contains": "外感天行，经方之药，有二旦、六神大小等汤"
    },
    {
      "id": "D08",
      "source": "shennong_bencao",
      "anchor": "t06-sn-p00368",
      "contains": "欲疗病，先察其原，先候病机"
    },
    {
      "id": "D09",
      "source": "shennong_bencao",
      "anchor": "t06-sn-p00368",
      "contains": "药有酸、咸、甘、苦、辛五味，又有寒、热、温、凉四气"
    }
